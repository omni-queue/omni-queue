{
  "name": "vasto",
  "version": "0.1.0",
  "private": true,
  "description": "A distributed job queue system with multiple storage backends",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:core": "turbo run build --filter=@vasto/core",
    "docs:dev": "npm run dev --workspace @vasto/docs",
    "docs:build": "npm run build --workspace @vasto/docs",
    "docs:preview": "npm run preview --workspace @vasto/docs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:integration": "npm run test:integration --workspace @vasto/redis-store && npm run test:integration --workspace @vasto/postgres-store",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "prettier": "^3.2.4",
    "tsup": "^8.5.1",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.1.1",
    "@vitest/coverage-v8": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.11.0"
}

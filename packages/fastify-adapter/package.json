{
  "name": "@vasto/fastify-adapter",
  "version": "0.1.0",
  "description": "Fastify adapter for Vasto dashboard-api",
  "keywords": [
    "queue",
    "dashboard",
    "fastify",
    "adapter",
    "vasto"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vasto/dashboard-api": "*"
  },
  "peerDependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

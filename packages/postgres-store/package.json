{
  "name": "@omni-queue/postgres-store",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL storage adapter for Omni-Queue",
  "keywords": [
    "queue",
    "job",
    "postgres",
    "postgresql",
    "storage",
    "omni-queue"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:integration": "vitest run tests/postgres-store.integration.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@omni-queue/core": "*",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  }
}

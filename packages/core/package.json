{
  "name": "@vasto/core",
  "version": "0.1.0",
  "description": "Core abstractions and interfaces for Vasto",
  "keywords": [
    "queue",
    "job",
    "worker",
    "distributed",
    "task",
    "background"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/binarygeotech/vasto.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./libs/isolation-worker": {
      "types": "./dist/libs/isolation-worker.d.ts",
      "import": "./dist/libs/isolation-worker.js",
      "require": "./dist/libs/isolation-worker.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "node-cron": "^4.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

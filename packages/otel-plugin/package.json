{
  "name": "@vasto/otel-plugin",
  "version": "0.1.0",
  "description": "OpenTelemetry tracing plugin for Vasto",
  "keywords": [
    "queue",
    "otel",
    "opentelemetry",
    "tracing",
    "plugin",
    "vasto"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vasto/core": "*",
    "@opentelemetry/api": "^1.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

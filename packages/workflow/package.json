{
  "name": "@vasto-queue/workflow",
  "version": "0.1.0",
  "description": "Workflow engine utilities for Vasto",
  "keywords": [
    "queue",
    "workflow",
    "dag",
    "orchestration",
    "vasto"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vasto-queue/core": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}

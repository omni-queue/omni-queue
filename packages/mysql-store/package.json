{
  "name": "@vasto/mysql-store",
  "version": "0.1.0",
  "description": "MySQL storage adapter for Vasto",
  "keywords": [
    "queue",
    "job",
    "mysql",
    "storage",
    "vasto"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vasto/core": "*",
    "mysql2": "^3.14.4"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@vasto-queue/elysia-adapter",
  "version": "0.1.0",
  "description": "Elysia adapter for Vasto dashboard integration",
  "keywords": [
    "queue",
    "dashboard",
    "elysia",
    "bun",
    "adapter",
    "vasto"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vasto-queue/dashboard-api": "*",
    "elysia": "^1.3.9",
    "express": "^4.21.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

# Benchmark environment variables
# Copy to .env and set values for your local setup.

# Example unauthenticated Redis:
# REDIS_URL=redis://localhost:6379

# Example password-auth Redis:
# REDIS_URL=redis://:yourpassword@localhost:6379

# Example Postgres DSN:
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/vasto_bench

# Leave empty to skip backend-specific scenarios.
REDIS_URL=
POSTGRES_URL=
MYSQL_URL=

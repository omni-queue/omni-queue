{
  "name": "@omni-queue/dashboard-api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP bindings for Omni Queue dashboard APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@omni-queue/core": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1",
    "@types/node": "^20.11.5"
  }
}

{
  "name": "@omni-queue/metrics",
  "version": "0.1.0",
  "description": "Metrics collection and exporters for Omni-Queue",
  "keywords": [
    "queue",
    "job",
    "metrics",
    "prometheus",
    "statsd",
    "datadog",
    "omni-queue"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@omni-queue/core": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}

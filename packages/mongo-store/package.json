{
  "name": "@omni-queue/mongo-store",
  "version": "0.1.0",
  "private": true,
  "description": "MongoDB storage adapter for Omni-Queue",
  "keywords": [
    "queue",
    "job",
    "mongo",
    "mongodb",
    "storage",
    "omni-queue"
  ],
  "author": "Okojie George",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@omni-queue/core": "*",
    "mongodb": "^6.18.0"
  }
}

{
  "name": "redis-isolation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "server": "npm run build && node dist/server.js",
    "server:dev": "vite build && node dist/server.js",
    "dashboard": "cd ../../packages/dashboard && VITE_API_TARGET=http://localhost:3100 npm run dev",
    "dev:dashboard": "concurrently \"npm run server:dev\" \"npm run dashboard\"",
    "worker": "npm run generate:isolation && npm run build && node dist/worker.js",
    "dev": "npm run worker",
    "start": "npm run worker",
    "generate:isolation": "vasto generate isolation",
    "dashboard:publish": "queue dashboard:publish",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@vasto/core": "*",
    "@vasto/dashboard-api": "*",
    "@vasto/redis-store": "*",
    "@vasto/plugins": "*",
    "express": "^4.21.2",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@vasto/cli": "*",
    "concurrently": "^9.1.0"
  }
}
